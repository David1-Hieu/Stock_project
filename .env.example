# ==============================================================================
# AI Stock Dashboard Configuration Template
# Sao chép file này thành .env và điền các giá trị thích hợp:
# cp .env.example .env
# ==============================================================================

# Flask Configuration
FLASK_ENV=development
STOCK_ANALYZE_SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration (Optional, mặc định: data/stock_analyze.db)
# STOCK_ANALYZE_DB=data/stock_analyze.db

# Ollama LLM Configuration (Local AI)
# OLLAMA_TIMEOUT=240
# OLLAMA_MAX_ATTEMPTS=1

# Vnstock API Key (Tùy chọn nếu sử dụng gói tài trợ hoặc gói chuyên sâu từ vnstocks.com)
# VNSTOCK_API_KEY=your_vnstock_api_key_here

# DNSE OpenAPI Configuration (Tùy chọn cho dữ liệu thị trường & chỉ số real-time từ DNSE)
# DNSE_API_KEY=your_dnse_api_key
# DNSE_API_SECRET=your_dnse_api_secret
# DNSE_BASE_URL=https://openapi.dnse.com.vn
# DNSE_API_VERSION=2026-07-23

# Market Data Routing (Mặc định: dnse nếu có key, tự động fallback sang vnstock)
# MARKET_DATA_PRIMARY=dnse
# MARKET_DATA_INTRADAY_PRIMARY=dnse
# MARKET_DATA_EOD_STOCK_PRIMARY=vnstock
# MARKET_DATA_EOD_INDEX_PRIMARY=dnse
