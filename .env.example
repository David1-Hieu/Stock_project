# ==============================================================================
# AI Stock Dashboard Configuration Template
# Sao chép file này thành .env và điền các giá trị thích hợp:
# cp .env.example .env
# ==============================================================================

# Flask Configuration
FLASK_ENV=development
STOCK_ANALYZE_SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration (Optional, mặc định: data/stock_analyze.db)
# STOCK_ANALYZE_DB=data/stock_analyze.db

# Ollama LLM Configuration (Local AI)
# OLLAMA_TIMEOUT=240
# OLLAMA_MAX_ATTEMPTS=1

# Vnstock API Key (Tùy chọn nếu sử dụng gói tài trợ hoặc gói chuyên sâu từ vnstocks.com)
# VNSTOCK_API_KEY=your_vnstock_api_key_here
